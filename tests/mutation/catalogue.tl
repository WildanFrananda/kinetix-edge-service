   },
   {
      id = "cookie-samesite",
      check = "the cookie is SameSite=Strict",
      file = "src/http/cookies.tl",
      old = "local ATTRIBUTES = \"Path=/; Secure; HttpOnly; SameSite=Strict\"",
      new = "local ATTRIBUTES = \"Path=/; Secure; HttpOnly; SameSite=Lax\"",
      unit = { "cookies" },
      integration = { "sign_in" },
   },
   {
      id = "cookie-duplicate",
      check = "a cookie sent twice is read as no cookie",
      file = "src/http/cookies.tl",
      old = "   if seen ~= 1 or not cookies.is_value(found) then",
      new = "   if seen == 0 or not cookies.is_value(found) then",
      unit = { "cookies" },
      integration = { "sign_in" },
   },
   {
      id = "idle-past-absolute",
      check = "the idle TTL is never extended past the absolute end",
      file = "src/http/lifetimes.tl",
      old = "   if remaining < idle then",
      new = "   if remaining < 0 then",
      unit = { "lifetimes" },
      integration = { "expiry" },
   },
   {
      id = "absolute-limit",
      check = "a session ends at its absolute end",
      file = "src/http/lifetimes.tl",
      old = "   return now_ms >= session.absolute_end",
      new = "   return now_ms >= session.absolute_end + 3600000",
      unit = { "lifetimes" },
      integration = { "expiry" },
   },
   {
      id = "single-flight",
      check = "one refresh per session at a time",

      unit = {},
      integration = { "redis_down" },
   },
   {
      id = "store-outage-ready",
      check = "readiness needs Redis to answer PING as the edge user",
      file = "src/http/health.tl",
      old = "respond.error(\"SESSION_STORE_UNAVAILABLE\", request.request_id, nil)\n   end\n\n   local answered",
      new = "respond.json(200, { status = \"ready\" }, nil)\n   end\n\n   local answered",
      unit = {},
      integration = { "redis_down" },
   },
   {
      id = "store-before-identity",
      check = "a sign-in is refused before identity is asked when Redis is down",
      file = "src/http/sign_in.tl",
      old = "   if client == nil then\n      return\n   end\n\n   settle_login(",

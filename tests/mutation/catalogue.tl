      unit = {},
      integration = { "refresh" },
   },
   {
      id = "store-outage-session",
      check = "Redis unreachable is 503, never \"signed out\"",
      file = "src/http/session_endpoint.tl",
      old = "respond.error(\"SESSION_STORE_UNAVAILABLE\", request.request_id, nil)\n   end\n\n   local value =",

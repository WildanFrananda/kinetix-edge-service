      old = "   if not sessions.admits(request.app, grant.role) then",
      new = "   if sessions.admits(request.app, \"nobody\") then",
      unit = {},
      integration = { "refresh" },
   },
   {
      id = "role-refused-logout",
      check = "a refused role is logged out at identity",
      file = "src/http/sign_in.tl",
      old = "      sessions.log_out_quietly(request, grant, stage)\n      logger.info(",
      new = "      logger.info(",
      unit = {},
      integration = { "roles" },
   },
   {
      id = "enrolment-seller-web",
      check = "the seller web takes no admin enrolment",
      file = "src/http/sign_in.tl",
      old = "      if not request.app.enrolment then",
      new = "      if not request.app.enrolment and request.app.roles[1] == \"nobody\" then",
      unit = {},
      integration = { "two_factor" },
   },
   {
      id = "pending-kind",
      check = "an enrolment cannot stand in for a two-factor challenge",
      file = "src/http/sessions.tl",
      old = "   if fields[\"kind\"] ~= kind or fields[\"app\"] ~= request.app.name",
      new = "   if fields[\"kind\"] == nil and kind == nil or fields[\"app\"] ~= request.app.name",
      unit = {},
      integration = { "two_factor" },
   },
   {
      id = "fixation",
      check = "a sign-in deletes the session the browser brought",
      file = "src/http/sessions.tl",
      old = "      table.insert(removed, previous_key)",
      new = "      replaced = replaced or false",
      unit = {},
      integration = { "fixation" },
   },
   {
      id = "hashed-key",
      check = "Redis keys a session by the SHA-256 of its cookie, never by the cookie",
      file = "src/http/sessions.tl",
      old = "   return SESSION_PREFIX .. digest.sha256_hex(value)",
      new = "   return SESSION_PREFIX .. value",
      unit = {},
      integration = { "sign_in" },
   },
   {
      id = "app-binding",
      check = "a session is honoured only on its own application's host",
      file = "src/http/sessions.tl",
      old = "   if session.app ~= request.app.name then",
      new = "   if session.app == nil then",
      unit = {},
      integration = { "sign_in" },
   },
   {
      id = "cookie-httponly",
      check = "the cookie is HttpOnly",
      file = "src/http/cookies.tl",
      old = "local ATTRIBUTES = \"Path=/; Secure; HttpOnly; SameSite=Strict\"",
      new = "local ATTRIBUTES = \"Path=/; Secure; SameSite=Strict\"",
      unit = { "cookies" },

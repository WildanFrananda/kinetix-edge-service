      integration = { "redis_down" },
   },
   {
      id = "ttl-on-every-key",
      check = "every key the edge writes has a TTL",
      file = "src/adapters/redis_store.tl",
      old = "   client:pexpire(key, ttl_ms)",
      new = "   client:hset(key, \"ttl\", tostring(ttl_ms))",
      unit = {},
      integration = { "redis_acl" },
   },
   {
      id = "forward-cookie",
      check = "the browser's Cookie is never forwarded",

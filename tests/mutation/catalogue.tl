local type Mutation = require("tests.mutation.types.mutation")

local record catalogue
   mutations: {Mutation}
end

catalogue.mutations = {
   {
      id = "csrf-foreign-origin",
      check = "a state-changing request from another origin is refused",
      file = "src/http/csrf.tl",
      old = "      return \"origin\"",
      new = "      return nil",
      unit = { "csrf" },
      integration = { "csrf" },
   },
   {
      id = "csrf-fetch-site",
      check = "without an Origin, only Sec-Fetch-Site: same-origin is admitted",
      file = "src/http/csrf.tl",
      old = "   if fetch_site == \"same-origin\" then",
      new = "   if fetch_site ~= \"cross-site\" then",
      unit = { "csrf" },
      integration = { "csrf" },
   },
   {
      id = "json-only",
      check = "request bodies must be application/json",
      file = "src/http/router.tl",
      old = "      if not csrf.is_json(context.single(request.headers, \"content-type\")) then",
      new = "      if csrf.is_json(\"text/plain\") then",
      unit = {},
      integration = { "csrf" },
   },
   {
      id = "role-gate-sign-in",

local app_version = require("http.app_version")
local check = require("tests.support.check")

describe("app_version", function()
   it("parses and compares strict semantic versions", function()
      local maj, min, pat = app_version.parse_semver("1.10.2")
      check.equal(maj, 1, "major")
      check.equal(min, 10, "minor")
      check.equal(pat, 2, "patch")
      check.equal(app_version.compare("1.10.0", "1.2.9"), 1, "1.10 > 1.2")
      check.equal(app_version.compare("1.0.0", "1.0.0"), 0, "equal")
      check.equal(app_version.compare("0.9.9", "1.0.0"), -1, "older")
      check.absent(app_version.parse_semver("v1.0.0"), "prefix v invalid")
      check.absent(app_version.parse_semver("01.0.0"), "leading zero invalid")
      check.absent(app_version.parse_semver("1.0"), "two parts invalid")
   end)

   it("allows absent headers during transition and refuses outdated or malformed mobile versions", function()
      local absent = app_version.evaluate("courier-app", nil)
      check.truthy(absent.ok, "absent version allowed")
      check.equal(absent.reason, "absent", "absent reason")

      local malformed = app_version.evaluate("courier-app", "bad-version")
      check.falsy(malformed.ok, "malformed rejected")
      check.equal(malformed.error_code, "INVALID_REQUEST", "malformed error code")

      local outdated = app_version.evaluate("Courier-App", "0.9.9")
      check.falsy(outdated.ok, "outdated refused")
      check.equal(outdated.error_code, "UPGRADE_REQUIRED", "426 upgrade required")
      check.equal(outdated.minimum_version, "1.0.0", "minimum version returned")
      check.matches(outdated.store_url, "^https://play%.google%.com/", "store url returned")

      local supported = app_version.evaluate("courier-app", "1.0.0")
      check.truthy(supported.ok, "minimum supported version allowed")
      check.equal(supported.version, "1.0.0", "trimmed version returned")
   end)
end)

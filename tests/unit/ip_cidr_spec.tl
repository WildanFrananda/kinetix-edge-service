local check = require("tests.support.check")
local ip_cidr = require("http.ip_cidr")
local webhook = require("config.webhook")

describe("ip_cidr", function()
   it("parses strict dotted-quad IPv4 addresses and rejects malformed inputs", function()
      check.equal(ip_cidr.parse_ipv4("0.0.0.0"), 0, "min ipv4")
      check.equal(ip_cidr.parse_ipv4("255.255.255.255"), 4294967295, "max ipv4")
      check.absent(ip_cidr.parse_ipv4(nil), "nil")
      check.absent(ip_cidr.parse_ipv4("01.0.0.1"), "leading zero rejected")
      check.absent(ip_cidr.parse_ipv4("256.0.0.1"), "octet above 255 rejected")
      check.absent(ip_cidr.parse_ipv4("10.0.0"), "short address rejected")
      check.absent(ip_cidr.parse_ipv4("2001:db8::1"), "ipv6 rejected")
   end)

   it("matches host and subnet CIDRs accurately", function()
      check.truthy(ip_cidr.matches("103.208.23.6", "103.208.23.0/24"), "inside /24")
      check.truthy(ip_cidr.matches("103.208.23.255", "103.208.23.0/24"), "top of /24")
      check.falsy(ip_cidr.matches("103.208.24.0", "103.208.23.0/24"), "outside /24")
      check.truthy(ip_cidr.matches("103.127.17.254", "103.127.16.0/23"), "inside /23")
      check.falsy(ip_cidr.matches("103.127.18.0", "103.127.16.0/23"), "outside /23")
      check.truthy(ip_cidr.matches("34.101.68.130", "34.101.68.130/32"), "exact /32")
      check.falsy(ip_cidr.matches("34.101.68.131", "34.101.68.130/32"), "adjacent /32")
      check.truthy(ip_cidr.matches("192.0.2.5", "0.0.0.0/0"), "all /0")
   end)

   it("admits configured Midtrans sandbox and production IPs and blocks unrelated senders", function()
      check.truthy(ip_cidr.matches_any("34.101.68.130", webhook.midtrans_cidrs), "midtrans legacy sandbox")
      check.truthy(ip_cidr.matches_any("149.129.216.115", webhook.midtrans_cidrs), "midtrans sandbox")
      check.truthy(ip_cidr.matches_any("103.208.23.6", webhook.midtrans_cidrs), "midtrans prod /24")
      check.truthy(ip_cidr.matches_any("8.215.30.222", webhook.midtrans_cidrs), "midtrans prod new ip")
      check.falsy(ip_cidr.matches_any("198.51.100.23", webhook.midtrans_cidrs), "untrusted ip refused")
      check.falsy(ip_cidr.matches_any("127.0.0.1", webhook.midtrans_cidrs), "loopback refused")
   end)
end)

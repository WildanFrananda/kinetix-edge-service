local check = require("tests.support.check")
local json_relay = require("adapters.json_relay")

describe("json_relay", function()
   it("keeps empty arrays and empty objects apart when it encodes again", function()
      local document = json_relay.document("{\"a\":[],\"b\":{},\"c\":[{\"t\":[]}],\"u\":\"x/y\",\"n\":120000}")
      check.present(document, "an object")
      check.equal(json_relay.encode(document["a"]), "[]", "an empty array")
      check.equal(json_relay.encode(json_relay.object(document, "b")), "{}", "an empty object")
      check.equal(json_relay.encode(document["c"]), "[{\"t\":[]}]", "nested arrays")
      check.equal(json_relay.encode(document["u"]), "\"x/y\"", "a slash left alone")
      check.equal(json_relay.encode(document["n"]), "120000", "a number")
   end)

   it("reads only a JSON object as a document", function()
      check.absent(json_relay.document(nil), "nothing")
      check.absent(json_relay.document(""), "empty")
      check.absent(json_relay.document("[]"), "an empty array")
      check.absent(json_relay.document("[{\"a\":1}]"), "an array")
      check.absent(json_relay.document("\"text\""), "a string")
      check.absent(json_relay.document("1"), "a number")
      check.absent(json_relay.document("{"), "not JSON")
      check.absent(json_relay.document("{\"n\":NaN}"), "NaN is not JSON")
      check.absent(json_relay.document("{\"n\":0x10}"), "nor is a hexadecimal number")
      check.present(json_relay.document("{}"), "an empty object")
   end)

   it("takes a member only when it is an object", function()
      local document = json_relay.document("{\"a\":[],\"l\":[1],\"o\":{\"k\":1},\"e\":{},\"s\":\"x\",\"z\":null}")
      check.absent(json_relay.object(document, "a"), "an empty array")
      check.absent(json_relay.object(document, "l"), "an array")
      check.absent(json_relay.object(document, "s"), "a string")
      check.absent(json_relay.object(document, "z"), "null")
      check.absent(json_relay.object(document, "missing"), "missing")
      check.absent(json_relay.object(nil, "o"), "no document")
      check.present(json_relay.object(document, "o"), "an object")
      check.present(json_relay.object(document, "e"), "an empty object")
   end)

   it("refuses to encode what JSON cannot carry", function()
      local document = json_relay.document("{\"n\":1e999}")
      check.absent(json_relay.encode(document), "infinity")
   end)
end)

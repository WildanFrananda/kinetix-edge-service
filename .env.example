# Kinetix edge service: every variable is required and has no default. The service refuses to
# start, naming each missing or unusable one. nginx passes only the variables nginx.conf lists
# with `env`, so a new one goes there too.

# Redis, as the edge's own ACL user (keys under edge:, the commands in README.md).
EDGE_REDIS_HOST=kinetix-redis
EDGE_REDIS_PORT=6379
EDGE_REDIS_USER=edge
EDGE_REDIS_PASSWORD=

# identity, called directly for sign-in, two-factor, refresh and logout. Scheme, host and port only.
IDENTITY_HTTP_URL=http://kinetix-identity-service:5000

# The gateway's internal plaintext listener (http:// only), where /bff/api/<path> is forwarded as /api/<path> and the
# seller web's merchant socket is proxied to /ws/v1/matching/merchant.
EDGE_API_UPSTREAM=http://kinetix-api-gateway:8000

# The web applications' hosts, as the gateway forwards them (host:port in the lab). Each app's
# origin is https://<host>; the app is told apart by host name, so the two must differ in name.
KINETIX_BACKOFFICE_HOST=backoffice.localhost:8443
KINETIX_SELLER_HOST=seller.localhost:8443

# Baked into the image from the build argument of the same name (the git sha); set it by hand
# only when running the generated Lua outside the image.
KINETIX_SERVICE_VERSION=
